-- Criar um banco dados e usá-lo
CREATE DATABASE MLKPs;
USE MLKPs;

CREATE TABLE turmas (
	-- INT AUTO_INCREMENT define uma coluna numérica do tipo inteiro
    -- que gera um número sequencial único
	id_turma INT AUTO_INCREMENT,
    -- VARCHAR é um tipo de dado usado para armazenar textos
	nome_turma VARCHAR(100) NOT NULL,
    -- NOT NULL é uma restrição que obriga preenchimento de valor
    curso VARCHAR(100) NOT NULL,
    
    -- PRIMARY KEY é uma coluna ou grupo de colunas que identifica
    -- de forma única cada linha em uma tabela
    PRIMARY KEY (id_turma)
);

CREATE TABLE alunos (
	id_aluno INT AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(150),
    -- DATE armazena valores de data (AAAA-MM-DD)
    data_nascimento DATE,
    id_turma INT,
    
    PRIMARY KEY (id_aluno),
    
    -- é uma coluna ou grupos de colunas em uma tabela que aponta
    -- para a primary key de outra tabela para ligar os dados entre elas
    FOREIGN KEY (id_turma)
		REFERENCES turmas(id_turma)

);

